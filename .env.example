# ──────────────────────────────────────────────────────────────────────────────
# Supabase — required (all three must be set)
# ──────────────────────────────────────────────────────────────────────────────

# Found in: Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Found in: Supabase dashboard → Project Settings → API → anon (public) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Found in: Supabase dashboard → Project Settings → API → service_role (secret) key
# SERVER ONLY — never expose this to the browser or commit it to version control
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ──────────────────────────────────────────────────────────────────────────────
# App URL — required in production
# ──────────────────────────────────────────────────────────────────────────────

# The public base URL of this deployment (no trailing slash).
# Used to generate QR code verification links on PDF certificates.
# Local dev:   http://localhost:3000
# Production:  https://your-custom-domain.com  (or your Vercel project URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
